# ==============================================================================
# AbogadoSoft - Variables de Entorno DESARROLLO LOCAL
# ==============================================================================
# Para desarrollo local con Supabase CLI:
#   1. supabase start       (levanta Postgres en 127.0.0.1:54322, Auth en :54321)
#   2. Copiar este archivo a .env y .env.local
#   3. bun run dev (backend) + vite (frontend)
#
# Para PRODUCCIÓN ver: .env.prod.example
# NUNCA commitear .env o .env.local — solo *.example se versiona.
# ==============================================================================

# ─── PostgreSQL (Supabase CLI local — supabase start) ────────────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"

# ─── Supabase Auth/Realtime (CLI local) ───────────────────────────────────────
# Las keys locales las genera "supabase start" — ver output del comando.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-dev-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-service-key"
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"

# ─── Backend API ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ─── Google OAuth (para Supabase Auth) ────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Google Drive (Service Account - RECOMENDADO) ─────────────────────────────
# Ruta al JSON de la Service Account (relativa al cwd del backend: carpeta backend/, o al repo si no existe ahí).
# Las SA no tienen cuota propia: usa carpetas dentro de una unidad compartida (Shared drive)
# de Google Workspace, o carpetas de "Mi unidad" compartidas con el client_email (rol Editor).
# Ver: https://developers.google.com/workspace/drive/api/guides/about-shareddrives
# Descargar JSON: Google Cloud Console > IAM > Service Accounts > Keys
GOOGLE_SERVICE_ACCOUNT_PATH="abogadosoft-xxxxxx.json"

# IDs de carpetas (obligatorios con SA; deben estar en esa unidad compartida o compartidas con la SA)
GOOGLE_DRIVE_FOLDER_DOCUMENTS=""
GOOGLE_DRIVE_FOLDER_CONTRACTS=""
GOOGLE_DRIVE_FOLDER_BACKUPS=""

# ─── Google Drive (OAuth2 - LEGACY, solo si no hay GOOGLE_SERVICE_ACCOUNT_PATH) ─
# No caduca la SA; el refresh OAuth sí puede requerir reautenticación manual.
# GOOGLE_REFRESH_TOKEN=""
# GOOGLE_REDIRECT_URI="http://localhost:4000/api/drive/auth/callback"

# ─── Storage / Archivos ──────────────────────────────────────────────────────
STORAGE_PATH="./storage/documents"
MAX_FILE_SIZE_MB=50

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:4000/api"
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-dev-key"

# ─── Liveblocks (Real-time Collaboration) ─────────────────────────────────────
# Get your API key from https://liveblocks.io/dashboard
VITE_LIVEBLOCKS_PUBLIC_KEY="pk_dev_your_public_key_here"

# ─── Búsqueda Global (Meilisearch) ────────────────────────────────────────────
# SEARCH_ENGINE=meilisearch  → usa Meilisearch self-hosted (requiere Docker)
# SEARCH_ENGINE=prisma       → fallback Prisma/PostgreSQL (sin infraestructura extra)
SEARCH_ENGINE="prisma"

# URL del contenedor de Meilisearch (por defecto puerto 7700)
# Desarrollo local (Colima + Docker CLI o Docker Desktop):
MEILISEARCH_HOST="http://localhost:7700"

# Llave maestra de Meilisearch — debe coincidir con MEILI_MASTER_KEY en docker-compose.yml
MEILISEARCH_KEY="masterKey123"
