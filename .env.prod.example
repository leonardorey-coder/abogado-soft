# ==============================================================================
# AbogadoSoft — Variables de Entorno PRODUCCIÓN
# ==============================================================================
# Copiar a .env.prod en el servidor y completar todos los valores.
# NUNCA versionar .env.prod — solo este .env.prod.example va al repo.
#
# Generar JWT_SECRET: openssl rand -base64 40
# ==============================================================================

# ─── PostgreSQL Self-Hosted ─────────────────────────────────────────────────────
# El hostname `db` corresponde al contenedor PostgreSQL del stack prod.
DATABASE_URL="postgresql://postgres:POSTGRES_PASSWORD@db:5432/abogadosoft?schema=public"
DIRECT_URL="postgresql://postgres:POSTGRES_PASSWORD@db:5432/abogadosoft?schema=public"

# ─── Auth JWT ────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 40
JWT_SECRET="MINIMO_40_CARACTERES_RANDOM"
JWT_REFRESH_SECRET="MINIMO_40_CARACTERES_RANDOM_DIFERENTE"

# ─── Backend API ──────────────────────────────────────────────────────────────
PORT=4001
NODE_ENV="production"
CORS_ORIGIN="http://SERVIDOR_IP"

# ─── Google Drive (Service Account) ──────────────────────────────────────────
GOOGLE_REDIRECT_URI="http://SERVIDOR_IP/api/drive/auth/callback"

# ─── Google Drive (Service Account) ──────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_PATH="./abogadosoft-service-account.json"
GOOGLE_DRIVE_FOLDER_DOCUMENTS=""
GOOGLE_DRIVE_FOLDER_CONTRACTS=""
GOOGLE_DRIVE_FOLDER_BACKUPS=""

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PATH="./storage/documents"
MAX_FILE_SIZE_MB=50

# ─── Storage Provider (Cloudflare R2 o disco local) ───────────────────────────
# Por defecto el backend usa R2 (StorageFactory). Para solo disco en el servidor:
#   STORAGE_PROVIDER=local
#   (STORAGE_PATH sigue siendo la carpeta local)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Opcional: dominio público del bucket (r2.dev o custom) para URLs públicas
# R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# ─── Frontend (Vite build) ────────────────────────────────────────────────────
VITE_API_URL="http://SERVIDOR_IP/api"
VITE_LIVEBLOCKS_PUBLIC_KEY=""

# ─── Meilisearch ──────────────────────────────────────────────────────────────
SEARCH_ENGINE="meilisearch"
MEILISEARCH_HOST="http://meilisearch:7700"
MEILISEARCH_KEY="CAMBIAR_A_LLAVE_SEGURA_EN_PROD"

# ─── PostgreSQL (contenedor Docker) ───────────────────────────────────────────
POSTGRES_PASSWORD="POSTGRES_PASSWORD"
