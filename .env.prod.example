# ==============================================================================
# AbogadoSoft — Variables de Entorno PRODUCCIÓN
# ==============================================================================
# Copiar a .env.prod en el servidor y completar todos los valores.
# NUNCA versionar .env.prod — solo este .env.prod.example va al repo.
#
# Generar JWT_SECRET:        openssl rand -base64 40
# Generar ANON_KEY/ROLE_KEY: ver infra/supabase/README.md
# ==============================================================================

# ─── PostgreSQL (Supabase self-hosted) ────────────────────────────────────────
# El contenedor de Postgres se llama "supabase_db" en el docker-compose de Supabase.
# Usamos la conexión directa en producción (sin pgBouncer para Prisma migrations).
DATABASE_URL="postgresql://postgres:POSTGRES_PASSWORD@supabase_db:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:POSTGRES_PASSWORD@supabase_db:5432/postgres?schema=public"

# ─── Supabase Auth / Realtime ─────────────────────────────────────────────────
# Kong API Gateway expone Auth y Realtime en el puerto 8000.
# Reemplazar SERVIDOR_IP con la IP o dominio interno del servidor.
SUPABASE_URL="http://SERVIDOR_IP:8000"
SUPABASE_ANON_KEY="GENERAR_JWT_PAYLOAD_role_anon"
SUPABASE_SERVICE_ROLE_KEY="GENERAR_JWT_PAYLOAD_role_service_role"
SUPABASE_JWT_SECRET="MINIMO_40_CARACTERES_RANDOM_openssl_rand_base64_40"

# ─── Backend API ──────────────────────────────────────────────────────────────
PORT=4001
NODE_ENV="production"
CORS_ORIGIN="http://SERVIDOR_IP"

# ─── Google OAuth (Supabase Auth) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://SERVIDOR_IP/api/drive/auth/callback"

# ─── Google Drive (Service Account) ──────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_PATH="./abogadosoft-service-account.json"
GOOGLE_DRIVE_FOLDER_DOCUMENTS=""
GOOGLE_DRIVE_FOLDER_CONTRACTS=""
GOOGLE_DRIVE_FOLDER_BACKUPS=""

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PATH="./storage/documents"
MAX_FILE_SIZE_MB=50

# ─── Storage Provider (Cloudflare R2 o disco local) ───────────────────────────
# Por defecto el backend usa R2 (StorageFactory). Para solo disco en el servidor:
#   STORAGE_PROVIDER=local
#   (STORAGE_PATH sigue siendo la carpeta local)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Opcional: dominio público del bucket (r2.dev o custom) para URLs públicas
# R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# ─── Frontend (Vite build) ────────────────────────────────────────────────────
VITE_API_URL="http://SERVIDOR_IP/api"
VITE_SUPABASE_URL="http://SERVIDOR_IP:8000"
VITE_SUPABASE_ANON_KEY="GENERAR_JWT_PAYLOAD_role_anon"
VITE_LIVEBLOCKS_PUBLIC_KEY=""

# ─── Meilisearch ──────────────────────────────────────────────────────────────
SEARCH_ENGINE="meilisearch"
MEILISEARCH_HOST="http://meilisearch:7700"
MEILISEARCH_KEY="CAMBIAR_A_LLAVE_SEGURA_EN_PROD"

# ─── Supabase self-hosted internals (usados por docker-compose de Supabase) ───
POSTGRES_PASSWORD="POSTGRES_PASSWORD"
JWT_SECRET="MINIMO_40_CARACTERES_RANDOM_openssl_rand_base64_40"
ANON_KEY="GENERAR_JWT_PAYLOAD_role_anon"
SERVICE_ROLE_KEY="GENERAR_JWT_PAYLOAD_role_service_role"
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="CAMBIAR_PASSWORD_DASHBOARD"
# SMTP (si se habilitan confirmaciones de email)
SMTP_ADMIN_EMAIL="admin@TU_DOMINIO"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SENDER_NAME="AbogadoSoft"
