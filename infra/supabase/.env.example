# ==============================================================================
# infra/supabase/.env.example — Variables para el stack Supabase self-hosted
# ==============================================================================
# En el servidor: copiar a infra/supabase/.env y completar.
# Los valores de JWT deben coincidir exactamente con los de .env.prod.
#
# Generar JWT_SECRET:  openssl rand -base64 40
# Generar ANON_KEY y SERVICE_ROLE_KEY:
#   Ver https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
#   o usar: node -e "const jwt=require('jsonwebtoken');
#     console.log(jwt.sign({role:'anon',iss:'supabase',iat:...,exp:...}, SECRET))"
# ==============================================================================

############
# Postgres
############
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE

############
# JWT
############
JWT_SECRET=MINIMO_40_CARACTERES_RANDOM_openssl_rand_base64_40
ANON_KEY=GENERAR_JWT_role_anon
SERVICE_ROLE_KEY=GENERAR_JWT_role_service_role

############
# API (PostgREST)
############
PGRST_DB_SCHEMAS=public

############
# Auth (GoTrue)
############
SITE_URL=http://SERVIDOR_IP:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://SERVIDOR_IP:8000

# Email
SMTP_ADMIN_EMAIL=admin@TU_DOMINIO
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=AbogadoSoft
ENABLE_EMAIL_CONFIRMATIONS=false

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://SERVIDOR_IP:8000/auth/v1/callback

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=AbogadoSoft
STUDIO_DEFAULT_PROJECT=AbogadoSoft
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CAMBIAR_PASSWORD_DASHBOARD

############
# Storage
############
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800

############
# Logflare / Analytics (desactivado por defecto)
############
LOGFLARE_LOGGER_BACKEND_API_KEY=
LOGFLARE_API_KEY=
