{
  "name": "sidoc-backend",
  "version": "0.1.0",
  "description": "API REST para SIDOC — Bun + Express + Prisma + Supabase (Auth + Realtime)",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "start": "bun dist/server.js",
    "prisma:generate": "bunx prisma generate",
    "prisma:push": "bunx prisma db push",
    "prisma:pull": "bunx prisma db pull",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:studio": "bunx prisma studio",
    "prisma:seed": "bun prisma/seed.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@hocuspocus/extension-database": "^3.4.4",
    "@hocuspocus/extension-logger": "^3.4.4",
    "@hocuspocus/server": "^3.4.4",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.0",
    "@supabase/supabase-js": "^2.49.4",
    "@superdoc-dev/superdoc-yjs-collaboration": "^1.0.2",
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-collaboration": "^3.19.0",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-text-align": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/html": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "diff": "^8.0.3",
    "express": "^5.1.0",
    "fastify": "^5.7.4",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "html-to-docx": "^1.8.0",
    "htmldiff-js": "^1.0.5",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "meilisearch": "^0.56.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.18.0",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.29",
    "zod": "^3.25.17"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.2.10",
    "@types/cors": "^2.8.17",
    "@types/diff": "^8.0.0",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "prisma": "^7.4.0",
    "typescript": "^5.8.2"
  }
}
