{
  "name": "sidoc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd backend && bun run dev",
    "dev:full": "concurrently \"vite\" \"cd backend && bun run dev\"",
    "dev:electron": "concurrently \"vite\" \"cd backend && bun run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:full": "concurrently \"bun run dev\" \"bun run dev:api\" \"wait-on http://localhost:3000 && bun run electron\"",
    "build": "vite build",
    "build:api": "cd backend && bun run build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dist": "vite build && mkdir -p build && cp public/sidoc_isologo.png build/icon.png && electron-builder",
    "electron:dist:mac": "vite build && mkdir -p build && cp public/sidoc_isologo.png build/icon.png && electron-builder --mac",
    "electron:dist:win": "vite build && mkdir -p build && cp public/sidoc_isologo.png build/icon.png && electron-builder --win",
    "setup": "npm install && cd backend && bun install && bunx prisma generate",
    "db:push": "cd backend && bunx prisma db push",
    "db:seed": "cd backend && bun run prisma:seed",
    "db:studio": "cd backend && bunx prisma studio"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "3.19.0",
    "@tiptap/extension-table": "3.19.0",
    "@tiptap/extension-table-cell": "3.19.0",
    "@tiptap/extension-table-header": "3.19.0",
    "@tiptap/extension-table-row": "3.19.0",
    "@tiptap/extension-text-align": "3.19.0",
    "@tiptap/extension-underline": "3.19.0",
    "@tiptap/pm": "3.19.0",
    "@tiptap/react": "3.19.0",
    "@tiptap/starter-kit": "3.19.0",
    "docx-preview": "0.3.7",
    "dompurify": "3.2.6",
    "html-to-image": "1.11.13",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.13.1",
    "superdoc": "1.11.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/dompurify": "3.0.5",
    "@types/node": "22.14.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.0",
    "concurrently": "9.1.0",
    "electron": "40.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "5.8.2",
    "vite": "6.2.0",
    "wait-on": "8.0.0"
  },
  "build": {
    "appId": "com.sidoc.desktop",
    "productName": "SIDOC",
    "copyright": "Copyright © SIDOC",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
